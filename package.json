{
  "name": "mfe-demo",
  "private": true,
  "workspaces": [
    "host",
    "products",
    "cart"
  ],
  "scripts": {
    "dev": "concurrently -n host,products,cart -c blue,green,magenta \"npm run dev -w host\" \"npm run dev -w products\" \"npm run dev -w cart\"",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
